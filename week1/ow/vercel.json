{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/images/(.*)",
      "dest": "/images/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/processed_mapData.json",
      "dest": "/processed_mapData.json",
      "headers": { "cache-control": "no-cache, no-store, must-revalidate" }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}